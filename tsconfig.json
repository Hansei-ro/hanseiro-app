{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },

    // ===== 타입 안정성 개선 옵션 =====

    // 1. 배열/객체 접근 시 undefined 체크 강제
    "noUncheckedIndexedAccess": true,

    // 2. 함수의 모든 분기에서 명시적 return 강제
    "noImplicitReturns": true,

    // 3. switch 문에서 case 끝에 break 빠뜨린 실수 방지
    "noFallthroughCasesInSwitch": true,

    // 4. 사용되지 않는 로컬 변수 경고 (코드 정리용)
    "noUnusedLocals": true,

    // 5. 사용되지 않는 함수 파라미터 경고 (단, _로 시작하면 제외)
    "noUnusedParameters": true,
    "typeRoots": ["./src/types", "./node_modules/@types"]
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.d.ts"]
}
