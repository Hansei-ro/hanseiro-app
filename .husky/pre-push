echo "🔍 푸시 전 검증 중... (약 30초~1분 소요)"
echo ""

# 1. 타입 체크
echo "📝 TypeScript 타입 체크..."
yarn type-check || {
  echo "❌ 타입 에러가 있습니다. 수정 후 다시 시도하세요."
  exit 1
}

# 2. 린트 검사
echo "🔍 ESLint 검사..."
yarn lint || {
  echo "❌ 린트 에러가 있습니다. 'yarn lint --fix'로 수정하세요."
  exit 1
}

# 3. 빌드 가능성 체크
echo "🏗️  빌드 가능성 체크..."
yarn build:check || {
  echo "❌ 빌드에 실패했습니다. 코드를 확인하세요."
  exit 1
}

echo ""
echo "✅ 모든 검증 통과! 푸시를 진행합니다."
